# For more information, please see the README.md
SUNO_COOKIE=
TWOCAPTCHA_KEY= # Obtain from 2captcha.com
BROWSER=chromium # `chromium` or `firefox`, although `chromium` is highly recommended
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true
API_BEARER_TOKEN= # Set this to a secret token to protect your API endpointsBROWSER_CHROME_CHANNEL= # Optional: prefer the installed real Chrome (`chrome`) over bundled Chromium — Turnstile trusts its fingerprint more
SUNO_PROXY_URL= # Optional outbound proxy (e.g. Proxidize sticky IP): http://user:pass@host:port — routes Suno API calls, the captcha browser and the 2captcha Turnstile solve through the same IP so tokens bind correctly
